{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"plugins": [
		"https://downloads.wordpress.org/plugin/easy-digital-downloads.3.7.1.zip",
		"https://downloads.wordpress.org/plugin/give.4.17.0.zip"
	],
	"mappings": {
		"wp-content/plugins/rave-payment-forms": ".",
		"wp-content/mu-plugins/flw-e2e-mock.php": "./tests/e2e/fixtures/mock-flutterwave.php"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp plugin activate rave-payment-forms easy-digital-downloads give && wp-env run tests-cli wp plugin activate rave-payment-forms"
	}
}
